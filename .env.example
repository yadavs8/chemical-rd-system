# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Private AI-Powered Chemical R&D Experiment and Apparatus Management System
# ==============================================================================
# NOTE: Never commit sensitive keys or actual credentials to version control.
# Copy this file to .env.local for local development.

# ------------------------------------------------------------------------------
# 1. DEDICATED SUPABASE CONFIGURATION (ISOLATED PROJECT)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-dedicated-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-secure-database-password

# Direct connection string for migrations (via pooling or direct 5432)
DATABASE_URL=postgresql://postgres.your-dedicated-project-ref:your-secure-database-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. AI MODEL APIS & ORCHESTRATION (COMMERCIAL WITH ZERO RETENTION)
# ------------------------------------------------------------------------------
# Anthropic Claude 3.5 API
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional OpenAI Embeddings (for pgvector RAG, if not using local models)
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small

# Offline / Air-Gapped Local LLM Fallback (e.g. Ollama or vLLM)
USE_LOCAL_LLM=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3:70b

# ------------------------------------------------------------------------------
# 3. FASTAPI SCIENTIFIC ENGINE & SIDECAR SERVICE
# ------------------------------------------------------------------------------
SCIENTIFIC_SERVICE_URL=http://localhost:8000
SCIENTIFIC_SERVICE_SECRET=your-internal-service-shared-secret

# ------------------------------------------------------------------------------
# 4. APPLICATION SETTINGS & SECURITY
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=3000
NEXTAUTH_SECRET=your-random-32-char-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Public registration is disabled; users must be invited or provisioned
ALLOW_PUBLIC_SIGNUP=false
